# Copy to .env (or set these as secrets/env vars on Replit/Render/Railway)
# Your Discord user token (from browser DevTools > Network > authorization header)
token=

# Voice channel ID to join and stay in.
# How to get it: Discord Settings > Advanced > Developer Mode ON,
# then right-click the voice channel > Copy Channel ID.
VOICE_CHANNEL_ID=

# Optional: server ID (only needed if the logs say the channel was not found)
GUILD_ID=

# How you show in VC. Default: mic on (SELF_MUTE=false), deafened (SELF_DEAF=true).
# No audio is sent either way.
SELF_MUTE=false
SELF_DEAF=true

# Auto-rejoin if kicked/moved/disconnected (default: true)
AUTO_REJOIN=true
REJOIN_DELAY=5000
WATCHDOG_INTERVAL=30000

# Command prefix for self-commands (!join, !leave, !status, !vcs, !help)
COMMAND_PREFIX=!

# Log every gateway message (noisy; default: false)
DEBUG=false

# Activity under the account's name: both | custom | rich | off
ACTIVITY=both
# online | idle | dnd | invisible
STATUS=online
# Custom status text. {total} {stay} {channel} {server} are filled in.
# {pet} is the virtual pet's line; its face replaces the emoji unless CUSTOM_STATUS_EMOJI is set.
CUSTOM_STATUS={pet} · In VC for {total}
# CUSTOM_STATUS_EMOJI=🎧
# Virtual pet on the status line. People DM the account: feed, play, pat, stats.
PET=on
PET_NAME=Mochi
# PET_EMOJI=🐶
PET_SLEEP=23-7
PET_TIMEZONE=Asia/Kolkata
# Rich Presence card (uses your Discord application)
APPLICATION_ID=1575262829869662312
# Wording on the card: playing | listening | watching | competing
ACTIVITY_TYPE=competing
ACTIVITY_DETAILS=Chilling with Alya 🩷🎀
ACTIVITY_STATE=dev Lovelycrxshx ♠
# Link buttons under the card (up to two). Label "off" removes a button.
BUTTON1_LABEL=Self-run acc, not a real user
BUTTON1_URL=https://discord.com/users/825998094067695616
BUTTON2_LABEL=Contact Admin
BUTTON2_URL=https://discord.com/users/825998094067695616

# Folder for the VC timer file. Leave unset on Railway (attach a Volume instead).
# DATA_DIR=/data
